{
  "name": "mythicboost-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MythicBoost applicant overlay for World of Warcraft",
  "main": "src/main.js",
  "author": "Jenya",
  "license": "UNLICENSED",
  "overwolf": {
    "packages": [
      "gep",
      "overlay"
    ]
  },
  "scripts": {
    "start": "ow-electron .",
    "start:mock": "ow-electron . --mock",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/providers/raiderio.js && node --check src/providers/warcraftlogs.js && node --check src/renderer/app.js",
    "build": "ow-electron-builder --publish=never"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "^42.7.1",
    "@overwolf/ow-electron-builder": "^26.9.0"
  },
  "build": {
    "appId": "gg.mythicboost.desktop",
    "productName": "MythicBoost Desktop",
    "overwolf": {
      "requireSigning": false
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MythicBoost-Desktop-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
